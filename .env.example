# Copy this file to `.env` on the server and fill in real values.
# `.env` is gitignored — never commit it.

# Deploy key — long random string. Used by deploy.php / update.html.
# Generate with: openssl rand -hex 32
DEPLOY_KEY=

# Anthropic API key — used by api/advisor.php to call Claude.
# USE A DEDICATED KEY for retail (NOT the shared key used by fuel/alfa/Optimus).
# A separate key is the only way the Anthropic Console attributes spend to this
# app — with a shared key all four apps drain one balance and you can't tell
# which is costing what. Create one at console.anthropic.com → API keys.
# Read server-side only; never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Defaults to claude-haiku-4-5 (cheapest
# tier — chosen because this is a public advisor on your billing). Set to
# claude-sonnet-4-5 for higher answer quality at ~3-4x the cost.
# CLAUDE_MODEL=

# Optional cost controls (advisor.php) — tunable here without a redeploy.
#   ADVISOR_DAILY_CAP — max live Claude calls/day across ALL visitors. Above it
#     the advisor serves a friendly "limit reached" message and makes no call:
#     a hard ceiling on the daily bill even if a bot rotates IPs. Default 300,
#     0 disables. Lower it once you see real traffic in the usage log.
#   ADVISOR_CACHE_TTL — seconds an answer is cached for an identical question
#     (0 Claude calls on repeats). Default 21600 (6h), 0 disables.
# ADVISOR_DAILY_CAP=300
# ADVISOR_CACHE_TTL=21600
